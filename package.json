{
  "name": "@rhylthyme/timeline",
  "version": "2.0.0-beta.5",
  "description": "Timing engine, static Gantt renderer and <rhylthyme-timeline> player Web Component for Rhylthyme programs: resolve step start/end times from triggers, render an SVG timeline with dependency arrows (web and publication looks, palettes, configurable legend), play it with manual gates and indefinite steps. Zero dependencies.",
  "main": "src/index.js",
  "bin": {
    "rhylthyme-render": "bin/render.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/index.js",
    "./element": "./src/element.js",
    "./player": "./player/build.js"
  },
  "files": [
    "src/",
    "bin/",
    "player/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check:mirrors": "test ! -f ../tools/check_mirrors.sh || sh ../tools/check_mirrors.sh",
    "test": "npm run check:mirrors && node --test test/*.test.js"
  },
  "keywords": [
    "rhylthyme",
    "scheduling",
    "gantt",
    "timeline",
    "svg",
    "temporal"
  ],
  "author": "Jeremy Leipzig",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhylthyme/rhylthyme-timeline.git"
  },
  "bugs": {
    "url": "https://github.com/rhylthyme/rhylthyme-timeline/issues"
  },
  "homepage": "https://github.com/rhylthyme/rhylthyme-timeline#readme",
  "engines": {
    "node": ">=18"
  },
  "rhylthyme": {
    "supportedSchemaVersions": [
      "0.1.0",
      "0.2.0-alpha",
      "0.3.0-alpha"
    ]
  }
}
