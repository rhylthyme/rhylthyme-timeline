{
  "name": "@rhylthyme/timeline",
  "version": "2.0.0-beta.6",
  "description": "Timing engine, static Gantt renderer and <rhylthyme-timeline> player Web Component for Rhylthyme programs: resolve step start/end times from triggers, render an SVG timeline with dependency arrows (web and publication looks, palettes, configurable legend), play it with manual gates and indefinite steps. Zero dependencies.",
  "main": "src/index.js",
  "module": "esm/index.mjs",
  "types": "types/index.d.ts",
  "typesVersions": {
    "*": {
      "core": [
        "types/index.d.ts"
      ],
      "element": [
        "types/element.d.ts"
      ],
      "schedule": [
        "types/schedule.d.ts"
      ],
      "schedule/labmcp-catalog": [
        "types/labmcp-catalog.d.ts"
      ]
    }
  },
  "bin": {
    "rhylthyme-render": "bin/render.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./esm/index.mjs",
      "default": "./src/index.js"
    },
    "./core": {
      "types": "./types/index.d.ts",
      "import": "./esm/index.mjs",
      "default": "./src/index.js"
    },
    "./element": {
      "types": "./types/element.d.ts",
      "default": "./src/element.js"
    },
    "./schedule": {
      "types": "./types/schedule.d.ts",
      "browser": {
        "import": "./esm/schedule.browser.mjs",
        "default": "./src/schedule/browser.js"
      },
      "import": "./esm/schedule.mjs",
      "default": "./src/schedule/index.js"
    },
    "./schedule/labmcp-catalog": {
      "types": "./types/labmcp-catalog.d.ts",
      "default": "./src/schedule/labmcp-catalog.js"
    },
    "./browser/schedule.js": "./browser/schedule.js",
    "./browser/labmcp-catalog.js": "./browser/labmcp-catalog.js",
    "./player": "./player/build.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "esm/",
    "types/",
    "browser/",
    "bin/",
    "player/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build-esm.js && node tools/build-browser.js",
    "prepack": "npm run build",
    "check:mirrors": "test ! -f ../tools/check_mirrors.sh || sh ../tools/check_mirrors.sh",
    "test": "npm run check:mirrors && npm run build && node --test test/*.test.js"
  },
  "keywords": [
    "rhylthyme",
    "scheduling",
    "gantt",
    "timeline",
    "svg",
    "temporal"
  ],
  "author": "Jeremy Leipzig",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhylthyme/rhylthyme-timeline.git"
  },
  "bugs": {
    "url": "https://github.com/rhylthyme/rhylthyme-timeline/issues"
  },
  "homepage": "https://github.com/rhylthyme/rhylthyme-timeline#readme",
  "engines": {
    "node": ">=18"
  },
  "rhylthyme": {
    "supportedSchemaVersions": [
      "0.1.0",
      "0.2.0-alpha",
      "0.3.0-alpha"
    ]
  }
}
